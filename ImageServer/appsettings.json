{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "ConnectionString": "Host=localhost;Port=5432;Database=ImagesDB;Username=postgres;Password=postgres"
  },
  "Storage": {
    "ImagesDirectoryName": "Images",
    "PreviewsDirectoryName": "Previews",
    "ImagesTrashDirectoryName": "ImagesTrash",
    "PreviewTrashDirectoryName": "PreviewsTrash"
  },
  "Deletion": {
    "DelayTimeInSeconds": 100,
    "OneCycleDeletionsCount" : 20
  },
  "Service": {
    "ParallelismDegree": 4,
    "MaxAllowedPageSize": 100
  },
  "AllowedHosts": "*"
}
